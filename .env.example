PORT=3000
NODE_ENV=development

# Admin login (used at /admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-strong-password
SESSION_SECRET=change-this-to-another-long-random-secret

# Optional legacy API key for scripts/tools (Bearer token still works)
ADMIN_API_KEY=change-this-to-a-long-random-secret

CANONICAL_HOST=www.diversewayclinic.com
SITE_URL=https://www.diversewayclinic.com

# Postgres connection string (required). Vercel Postgres/Neon auto-injects
# POSTGRES_URL when connected to the project — this app accepts either name.
# Locally, point this at a local Postgres instance, e.g.:
# DATABASE_URL=postgres://youruser@localhost:5432/dwc_dev
DATABASE_URL=

# Redis connection string (required for reliable sessions on serverless).
# Vercel KV auto-injects KV_URL when connected — this app accepts either name.
# Locally, point this at a local Redis instance, e.g.:
# REDIS_URL=redis://localhost:6379
REDIS_URL=

# Cap each serverless instance's own Postgres connection pool (the upstream
# pooler — Neon/Vercel Postgres provide one — handles real connection reuse).
# PG_POOL_MAX=5

# WhatsApp notifications (Meta WhatsApp Business Cloud API) — optional.
# Every booking, contact message, and screening callback request auto-sends a
# WhatsApp notification to WHATSAPP_NOTIFY_NUMBERS once these are set. Until
# then, notifications are silently skipped. See setup steps in README/deploy notes.
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_NOTIFY_NUMBERS=9779845366417,9779841362404
# WHATSAPP_TEMPLATE_NAME=new_website_lead
# WHATSAPP_TEMPLATE_LANG=en
